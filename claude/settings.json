{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash($HOME/.claude/hooks/inject.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject.sh PreToolUse permission_mode__planning.md --once"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject.sh PostToolUse PostToolUse__ExitPlanMode.md"
          }
        ]
      },
      {
        "matcher": "TaskUpdate",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject.sh PostToolUse PostToolUse__TaskUpdate__completed.md --debounce 5 --when '.tool_input.status == \"completed\"'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject.sh PostToolUse PostToolUse__Bash__git_commit.md --debounce 5 --when '.tool_input.command | test(\"\\\\bgit\\\\s+commit(\\\\s|$)\")'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject.sh UserPromptSubmit permission_mode__planning.md --once --when '.permission_mode == \"plan\"'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Plan",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/inject.sh SubagentStart SubagentStart__Plan.md permission_mode__planning.md"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "env": {
    "CLAUDE_CODE_STOP_HOOK_BLOCK_CAP": "2"
  }
}
