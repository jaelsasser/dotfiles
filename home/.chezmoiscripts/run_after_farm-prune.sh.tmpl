#!/bin/sh
# Prune dangling farm symlinks the non-destructive farm leaves behind when a
# source is renamed or removed (no exact_ dirs, so chezmoi never clears them).
# Scoped to links into the source clone, so live runtime/harness state is untouched.
set -eu
src='{{ .chezmoi.sourceDir }}'

prune() {
  [ -d "$1" ] || return 0
  find "$1" -type l ! -exec test -e {} \; -print | while IFS= read -r link; do
    case "$(readlink "$link")" in
      "$src"/*) rm -f -- "$link" ;;
    esac
  done
}

prune "${XDG_CONFIG_HOME:-$HOME/.config}/emacs"
prune "$HOME/.claude"
