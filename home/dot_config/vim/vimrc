" vimrc — plugin-free spine for vim 9.x and Neovim. Vim finds it at
" $XDG_CONFIG_HOME/vim/vimrc itself (9.1.0327+); nvim sources it from init.lua.

" XDG: transient state -> $XDG_STATE_HOME, persistent undo -> $XDG_DATA_HOME
" (cache would lose marks/undo on a wipe). nvim is XDG-native and uses shada.
if !has('nvim')
    " defaults.vim FIRST: its `set nocompatible` resets viminfo (and more) to Vim
    " defaults as a side effect, so our overrides must follow it, not precede it.
    " (macOS /usr/share/vim/vimrc sets skip_defaults_vim=1 — undo it.)
    unlet! skip_defaults_vim
    silent! runtime defaults.vim

    let s:state = empty($XDG_STATE_HOME) ? expand('~/.local/state') : $XDG_STATE_HOME
    let s:data  = empty($XDG_DATA_HOME)  ? expand('~/.local/share') : $XDG_DATA_HOME
    call mkdir(s:state . '/vim', 'p')
    call mkdir(s:data  . '/vim/undo', 'p')

    let &backupdir   = s:state . '/vim'
    let &viminfofile = s:state . '/vim/viminfo'
    let &undodir     = s:data  . '/vim/undo'
    set viminfo='33,<50,s10,h    " counts only — filename lives in &viminfofile
endif

filetype plugin indent on
syntax enable

set undofile
set hidden
set autoread
set noswapfile
set mouse=
set hlsearch
set ignorecase smartcase
set splitbelow splitright
set expandtab shiftwidth=4 tabstop=4 softtabstop=-1 shiftround
set list listchars=tab:»\ ,trail:·,nbsp:·,extends:›,precedes:‹

let mapleader = "\<Space>"

" readline-ish insert mode — plain vim only; nvim uses vim-rsi (init.lua §7).
" Same Emacs reflexes both tiers honor: C-K kill-to-EOL, C-Y paste, C-G abort.
if !has('nvim')
    inoremap <C-A> <Home>
    inoremap <C-E> <End>
    inoremap <C-B> <Left>
    inoremap <C-F> <Right>
    inoremap <C-D> <Del>
    " <C-\><C-O> runs one cmd, cursor stays (clean EOL no-op).
    inoremap <C-K> <C-\><C-O>D
    inoremap <C-Y> <C-R><C-O>"
    inoremap <C-G> <C-\><C-N>
endif

if maparg('<C-L>', 'n') ==# ''
    nnoremap <silent> <C-L> :nohlsearch<CR><C-L>
endif

" :StripWhitespace — preserves cursor + scroll position
function! s:strip_whitespace() abort
    if &binary || &filetype ==# 'diff' | return | endif
    let l:view = winsaveview()
    keeppatterns %s/\s\+$//e
    call winrestview(l:view)
endfunction
command! StripWhitespace call s:strip_whitespace()
