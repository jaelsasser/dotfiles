" minimal vimrc — vim, vim-nox, nvim

" XDG: keep cruft out of $HOME (vim only; nvim respects XDG natively).
" vim 9.1+ finds this file at $XDG_CONFIG_HOME/vim/vimrc on its own.
if !has('nvim') && !empty($XDG_CACHE_HOME)
    set directory=$XDG_CACHE_HOME/vim,/tmp
    set backupdir=$XDG_CACHE_HOME/vim,/tmp
    set viminfo+=n$XDG_CACHE_HOME/vim/viminfo,'33
endif

" lean on upstream defaults; nvim already has these built in.
" macOS's /usr/share/vim/vimrc sets skip_defaults_vim=1 — undo it.
if !has('nvim')
    unlet! skip_defaults_vim
    silent! runtime defaults.vim
endif

filetype plugin indent on
syntax enable

set hidden                  " unsaved buffers ok
set autoread                " reload externally-changed files
set noswapfile              " never liked .swp
set mouse=                  " override defaults.vim's mouse=a
set hlsearch                " defaults.vim leaves this off
set ignorecase smartcase    " case-insensitive unless capitals present
set gdefault                " :s defaults to /g
set splitbelow splitright
set expandtab shiftwidth=4 tabstop=4 shiftround
set list listchars=tab:»\ ,trail:·,nbsp:·,extends:›,precedes:‹

let mapleader = "\<Space>"

" readline-ish insert mode (vim already does C-w, C-u, C-h);
" no real standard, just the common subset people expect
inoremap <C-A> <Home>
inoremap <C-E> <End>
inoremap <C-B> <Left>
inoremap <C-F> <Right>
inoremap <C-D> <Del>
inoremap <C-K> <C-O>D

" <C-L> also clears search highlight
if maparg('<C-L>', 'n') ==# ''
    nnoremap <silent> <C-L> :nohlsearch<CR><C-L>
endif

" :StripWhitespace — preserves cursor + scroll position
function! s:strip_whitespace() abort
    if &binary || &filetype ==# 'diff' | return | endif
    let l:view = winsaveview()
    keeppatterns %s/\s\+$//e
    call winrestview(l:view)
endfunction
command! StripWhitespace call s:strip_whitespace()
